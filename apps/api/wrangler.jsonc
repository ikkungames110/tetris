{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stack-tetris-api",
  "main": "index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stack-tetris",
      "database_id": "c6f7577c-a7ed-4489-bd1e-3d55b4502e45",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
}
